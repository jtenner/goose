struct H{values:i64[..3]}recursive fn run(a:i64[2]&,depth:i64)->i64{let old=a[0];var rows:H[]=[H{-a}];assert(rows[0].values.len==2);assert(rows[0].values[0] == -old);if depth>0{a[0]+=1;let child=run(a,depth-1);assert(rows[0].values[0] == -old);assert(rows[0].values[1]==8);return child+rows[0].values[1];}return rows[0].values[0]+rows[0].values[1];}fn main(){var a:i64[2]=[7,-8];let n=run(a,2);assert(n==15);assert(a[0]==9);print("function_data");}
