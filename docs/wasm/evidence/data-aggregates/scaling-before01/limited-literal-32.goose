struct Row { mark: u8, cells: u16[..3], tail: u8 }
fn main() { var rows: Row[] = [Row { mark: 1, cells: [7, 8], tail: 2 }, Row { mark: 1, cells: [7, 8], tail: 2 }, Row { mark: 1, cells: [7, 8], tail: 2 }, Row { mark: 1, cells: [7, 8], tail: 2 }, Row { mark: 1, cells: [7, 8], tail: 2 }, Row { mark: 1, cells: [7, 8], tail: 2 }, Row { mark: 1, cells: [7, 8], tail: 2 }, Row { mark: 1, cells: [7, 8], tail: 2 }, Row { mark: 1, cells: [7, 8], tail: 2 }, Row { mark: 1, cells: [7, 8], tail: 2 }, Row { mark: 1, cells: [7, 8], tail: 2 }, Row { mark: 1, cells: [7, 8], tail: 2 }, Row { mark: 1, cells: [7, 8], tail: 2 }, Row { mark: 1, cells: [7, 8], tail: 2 }, Row { mark: 1, cells: [7, 8], tail: 2 }, Row { mark: 1, cells: [7, 8], tail: 2 }, Row { mark: 1, cells: [7, 8], tail: 2 }, Row { mark: 1, cells: [7, 8], tail: 2 }, Row { mark: 1, cells: [7, 8], tail: 2 }, Row { mark: 1, cells: [7, 8], tail: 2 }, Row { mark: 1, cells: [7, 8], tail: 2 }, Row { mark: 1, cells: [7, 8], tail: 2 }, Row { mark: 1, cells: [7, 8], tail: 2 }, Row { mark: 1, cells: [7, 8], tail: 2 }, Row { mark: 1, cells: [7, 8], tail: 2 }, Row { mark: 1, cells: [7, 8], tail: 2 }, Row { mark: 1, cells: [7, 8], tail: 2 }, Row { mark: 1, cells: [7, 8], tail: 2 }, Row { mark: 1, cells: [7, 8], tail: 2 }, Row { mark: 1, cells: [7, 8], tail: 2 }, Row { mark: 1, cells: [7, 8], tail: 2 }, Row { mark: 1, cells: [7, 8], tail: 2 }]; assert(rows.len == 32); for &row in rows { assert(row.mark == 1); assert(row.cells.len == 2); assert(row.cells[0] == 7); assert(row.cells[1] == 8); assert(row.tail == 2); } print("scaling=ok"); }
