struct Item { a: u16, b: u16 }
struct Row { head: u8, payload: Item, tail: u8 }
var template: Item = Item { a: 7, b: 9 };
fn main() { var rows: Row[] = [Row { head: 3, payload: template, tail: 5 }, Row { head: 3, payload: template, tail: 5 }, Row { head: 3, payload: template, tail: 5 }, Row { head: 3, payload: template, tail: 5 }, Row { head: 3, payload: template, tail: 5 }, Row { head: 3, payload: template, tail: 5 }, Row { head: 3, payload: template, tail: 5 }, Row { head: 3, payload: template, tail: 5 }, Row { head: 3, payload: template, tail: 5 }, Row { head: 3, payload: template, tail: 5 }, Row { head: 3, payload: template, tail: 5 }, Row { head: 3, payload: template, tail: 5 }, Row { head: 3, payload: template, tail: 5 }, Row { head: 3, payload: template, tail: 5 }, Row { head: 3, payload: template, tail: 5 }, Row { head: 3, payload: template, tail: 5 }, Row { head: 3, payload: template, tail: 5 }, Row { head: 3, payload: template, tail: 5 }, Row { head: 3, payload: template, tail: 5 }, Row { head: 3, payload: template, tail: 5 }, Row { head: 3, payload: template, tail: 5 }, Row { head: 3, payload: template, tail: 5 }, Row { head: 3, payload: template, tail: 5 }, Row { head: 3, payload: template, tail: 5 }, Row { head: 3, payload: template, tail: 5 }, Row { head: 3, payload: template, tail: 5 }, Row { head: 3, payload: template, tail: 5 }, Row { head: 3, payload: template, tail: 5 }, Row { head: 3, payload: template, tail: 5 }, Row { head: 3, payload: template, tail: 5 }, Row { head: 3, payload: template, tail: 5 }, Row { head: 3, payload: template, tail: 5 }]; assert(rows.len == 32); for &row in rows { assert(row.payload.a == 7); assert(row.payload.b == 9); } rows[0].payload.a = 17; assert(template.a == 7); assert(rows[rows.len - 1].payload.a == 7); print("named-copy=ok"); }
