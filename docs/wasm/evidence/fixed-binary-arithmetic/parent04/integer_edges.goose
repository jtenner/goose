fn main(){var a:i8[2]=[-128,127];var b:i8[2]=[-1,-3];let q=a/b;let m=a%b;assert(q[0] == -128&&q[1] == -42);assert(m[0]==0&&m[1]==1);var c:i16[2]=[-32768,-13];var d:i16[2]=[-1,5];let r=c/d;let s=c%d;assert(r[0] == -32768&&r[1] == -2);assert(s[0]==0&&s[1]==2);var e:i32[2]=[-2147483648,-13];var f:i32[2]=[-1,-5];let g=e/f;let h=e%f;assert(g[0] == -2147483648&&g[1]==2);assert(h[0]==0&&h[1]==2);var i:i64[2]=[-9223372036854775808,-13];var j:i64[2]=[-1,-9223372036854775808];let k=i%j;assert(k[0]==0&&k[1]==9223372036854775795);print("integer_edges");}
