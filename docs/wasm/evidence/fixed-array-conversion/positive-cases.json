  "copy": "fn main(){var a:i64[2]=[7,-8];var c:i64[]=a;assert(c.len==2&&c[0]==7&&c[1] == -8);c[0]=99;assert(a[0]==7&&c[0]==99);print(\"copy\");}",
  "call": "recursive fn make()->i64[2]{return[7,-8];}fn main(){var c:i64[>..]=make();assert(c.len==2&&c[0]==7&&c[1] == -8);print(\"call\");}",
  "default": "fn main(){var c:i64[..]=default<i64[2]>();assert(c.len==2&&c.cap==2&&c[0]==0&&c[1]==0);print(\"default\");}",
