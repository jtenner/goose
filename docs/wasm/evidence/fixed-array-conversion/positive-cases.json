  "varint_binary": "fn main(){var a:i64[2]=[7,-8];var b:i64[2]=[3,4];var c:i64[varint]=a+b;assert(c.len==2&&c[0]==10&&c[1] == -4);assert(a[0]==7&&a[1] == -8&&b[0]==3&&b[1]==4);print(\"varint_binary\");}",
