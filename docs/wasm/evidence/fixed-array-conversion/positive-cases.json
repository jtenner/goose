{
  "variable_binary": "fn main(){var a:i64[2]=[7,-8];var b:i64[2]=[3,4];var c:i64[]=a+b;assert(c.len==2&&c[0]==10&&c[1] == -4);assert(a[0]==7&&a[1] == -8&&b[0]==3&&b[1]==4);print(\"variable_binary\");}",
  "variable_negation": "fn main(){var a:i64[2]=[7,-8];var b:i64[2]=[3,4];var c:i64[]=-a;assert(c.len==2&&c[0]==-7&&c[1] == 8);assert(a[0]==7&&a[1] == -8&&b[0]==3&&b[1]==4);print(\"variable_negation\");}",
  "grow_only_binary": "fn main(){var a:i64[2]=[7,-8];var b:i64[2]=[3,4];var c:i64[>..]=a+b;assert(c.len==2&&c[0]==10&&c[1] == -4);assert(a[0]==7&&a[1] == -8&&b[0]==3&&b[1]==4);print(\"grow_only_binary\");}",
  "grow_only_negation": "fn main(){var a:i64[2]=[7,-8];var b:i64[2]=[3,4];var c:i64[>..]=-a;assert(c.len==2&&c[0]==-7&&c[1] == 8);assert(a[0]==7&&a[1] == -8&&b[0]==3&&b[1]==4);print(\"grow_only_negation\");}",
  "grow_shrink_binary": "fn main(){var a:i64[2]=[7,-8];var b:i64[2]=[3,4];var c:i64[>..<]=a+b;assert(c.len==2&&c[0]==10&&c[1] == -4);assert(a[0]==7&&a[1] == -8&&b[0]==3&&b[1]==4);print(\"grow_shrink_binary\");}",
  "grow_shrink_negation": "fn main(){var a:i64[2]=[7,-8];var b:i64[2]=[3,4];var c:i64[>..<]=-a;assert(c.len==2&&c[0]==-7&&c[1] == 8);assert(a[0]==7&&a[1] == -8&&b[0]==3&&b[1]==4);print(\"grow_shrink_negation\");}",
  "runtime_limited_binary": "fn main(){var a:i64[2]=[7,-8];var b:i64[2]=[3,4];var c:i64[..]=a+b;assert(c.len==2&&c[0]==10&&c[1] == -4);assert(a[0]==7&&a[1] == -8&&b[0]==3&&b[1]==4);print(\"runtime_limited_binary\");}",
