struct S { x: i64 }
fn main() { var a: S[32] = [S { x: 0 }, S { x: 1 }, S { x: 2 }, S { x: 3 }, S { x: 4 }, S { x: 5 }, S { x: 6 }, S { x: 7 }, S { x: 8 }, S { x: 9 }, S { x: 10 }, S { x: 11 }, S { x: 12 }, S { x: 13 }, S { x: 14 }, S { x: 15 }, S { x: 16 }, S { x: 17 }, S { x: 18 }, S { x: 19 }, S { x: 20 }, S { x: 21 }, S { x: 22 }, S { x: 23 }, S { x: 24 }, S { x: 25 }, S { x: 26 }, S { x: 27 }, S { x: 28 }, S { x: 29 }, S { x: 30 }, S { x: 31 }]; print(a.len, ",", a[31].x); }
