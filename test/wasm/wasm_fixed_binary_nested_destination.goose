struct H{values:i64[..3]}var indices:i64=0;recursive fn index()->i64{indices++;return 0;}fn main(){var a:i64[2]=[7,-8];var b:i64[2]=[3,4];let h=H{a+b};assert(h.values.len==2&&h.values[0]==10&&h.values[1] == -4);var rows:H[]=[H{a-b}];assert(rows[0].values.len==2&&rows[0].values[0]==4&&rows[0].values[1] == -12);rows[index()].values=a+b;assert(indices==1);assert(rows[0].values.len==2&&rows[0].values[0]==10&&rows[0].values[1] == -4);print("nested_destination");}
