struct S{n:i64}var calls:i64=0;recursive fn walk(views:S[u8]&[3]&,depth:i64,parent:S?)->i64{calls++;var saved:i64[2]=[depth,90+depth];var total:i64=0;for s in views[depth]{if parent{assert(&s .!= parent&&parent.n==s.n+1);}assert(s.n==depth+1);if depth>0{total+=walk(views,depth-1,s);}assert(s.n==depth+1&&saved[0]==depth&&saved[1]==90+depth);total+=s.n;}return total;}fn main(){var a:S[u8]=[S{1}];var b:S[u8]=[S{2}];var c:S[u8]=[S{3}];var views:S[u8]&[3]=[a,b,c];assert(walk(views,2,null)==6&&calls==3);print("u8_recursion");}
