struct H{values:u16[..3]}struct S{values:u16[2]}recursive fn update(dst:u16[..3]&,src:u16[2]&){dst=src;}fn main(){var a:u16[2]=[7,8];var c:u16[..3]=[1,2,3];update(c,a);assert(c.len==2&&c[1]==8);var dest:H[]=[H{[1,2,3]}];var source:S[]=[S{[9,10]}];update(dest[0].values,source[0].values);assert(dest[0].values.len==2&&dest[0].values[1]==10&&source[0].values[0]==9);print("function_data");}
