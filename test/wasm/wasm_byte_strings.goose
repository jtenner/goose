var global: u8[u16] = "g\0x";
recursive fn call_copy() -> i64 {
    var copy: u8[] = "a\0bc";
    return copy.len + copy[0] + copy[1] + copy[3];
}
fn main() {
    print("before=", call_copy());
    var flat: u8[] = "a\0bc";
    var other: u8[] = "a\0bc";
    var fixed: u8[3] = "xyz";
    var limited: u8[..8] = "ab";
    var grow: u8[>..] = "go";
    var shrink: u8[>..<] = "no";
    let stable = &grow[0];
    limited.push(99); shrink.pop();
    flat[0] = 90;
    print(flat.len, ",", flat[0], ",", flat[1], ",", other[0], ",", fixed[2]);
    print(limited.len, ",", limited[2], ",", shrink.len, ",", shrink[0]);
    for i in 70000 { grow.push(120); }
    print(grow.len, ",", stable, ",", grow[70001]);
    var empty: u8[] = "";
    var emptyfixed: u8[0] = "";
    var emptygrow: u8[>..] = "";
    print(empty.len, ",", emptyfixed.len, ",", emptygrow.len);
    print("global=", global.len, ",", global[0], ",", global[1], ",", global[2]);
    print("after=", call_copy());
    print("large=", large_copy());
}
recursive fn large_copy() -> i64 { var data: u8[] = ""; return data.len + data[69999]; }
