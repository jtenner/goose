struct H{values:u16[..3]}struct C{target:H&}var source:u16[2]=[77,88];recursive fn get(c:C&,next:H&)->u16[2]&{c.target .= next;return source;}fn main(){var first:H[]=[H{[1,2,9]}];var second:H[]=[H{[3,4,8]}];var c=C{first[0]};c.target.values=get(c,second[0]);assert(first[0].values.len==2&&first[0].values[0]==77&&second[0].values.len==3&&second[0].values[0]==3&&c.target .== &second[0]);print("fat_order");}
