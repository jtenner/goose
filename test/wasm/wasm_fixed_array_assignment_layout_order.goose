struct H{values:u16[..3]}struct C{target:H&}var source:u16[2]=[77,88];recursive fn get(c:C&,next:H&)->u16[2]&{c.target .= next;return source;}fn main(){var first=H{[1,2,9]};var second=H{[3,4,8]};var c=C{first};c.target.values=get(c,second);assert(first.values.len==2&&first.values[0]==77&&first.values[1]==88&&second.values.len==3&&second.values[0]==3&&c.target .== &second);print("order");}
