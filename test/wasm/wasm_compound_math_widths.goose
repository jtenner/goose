fn main(){var a:i8[2]=[-128,127];var b:i8[2]=[-1,-3];a/=b;assert(a[0] == -128&&a[1] == -42);a%=b;assert(a[0]==0&&a[1]==0);var c:i16[2]=[-32768,-13];var d:i16[2]=[-1,5];c/=d;assert(c[0] == -32768&&c[1] == -2);c%=d;assert(c[0]==0&&c[1]==3);var e:i32[2]=[-2147483648,-13];var f:i32[2]=[-1,-5];e/=f;assert(e[0] == -2147483648&&e[1]==2);e%=f;assert(e[0]==0&&e[1]==2);print("widths");}
