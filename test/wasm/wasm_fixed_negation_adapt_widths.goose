fn main(){var a:i8[2]=[-128,127];let b:i8[..2]=-a;assert(b.len==2);assert(b[0] == -128);assert(b[1] == -127);var c:i16[2]=[-32768,32767];let d:i16[..3]=-c;assert(d.len==2);assert(d[0] == -32768);assert(d[1] == -32767);var e:i32[2]=[-2147483648,2147483647];let f:i32[..2]=-e;assert(f.len==2);assert(f[0] == -2147483648);assert(f[1] == -2147483647);var g:i64[2]=[-9223372036854775808,9223372036854775807];let h:i64[..3]=-g;assert(h.len==2);assert(h[0] == -9223372036854775808);assert(h[1] == -9223372036854775807);print("widths");}
