struct H{values:i64[..3]}recursive fn run(a:i64[2]&)->i64{var rows:H[]=[H{-a}];assert(rows[0].values.len==2);assert(rows[0].values[0] == -a[0]);assert(rows[0].values[1]==8);return rows[0].values[0]+rows[0].values[1];}recursive fn parent(a:i64[2]&)->i64{var held:H[]=[H{values:[1]}];let n=run(a);assert(held[0].values.len==1);assert(held[0].values[0]==1);return n;}fn main(){var a:i64[2]=[7,-8];let x=run(a);a[0]=9;let y=parent(a);assert(x==1);assert(y == -1);print("function_data");}
